{
  "name": "@xray-network/xray-js-cardano",
  "version": "3.0.0",
  "description": "Cardano SDK for XRAY/Network",
  "license": "MIT",
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "browser": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "browser": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx test/__dev.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/data.test.js .test-dist/message.test.js .test-dist/utils.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test .test-dist/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist .test-dist"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@scure/base": "2.2.0",
    "@scure/bip39": "2.2.0",
    "@xray-network/xray-cardano-lib": "0.1.0",
    "@xray-network/xray-cardano-lib-core": "0.1.0",
    "buffer": "^6.0.3",
    "cardano-koios-client": "^1.0.10",
    "cardano-kupo-client": "^1.0.1",
    "cardano-nftcdn-client": "^1.0.6",
    "cardano-ogmios-client": "^1.0.0"
  },
  "devDependencies": {
    "tsx": "^4.15.1"
  }
}
