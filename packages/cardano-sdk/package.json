{
  "name": "@xray-network/xray-js-cardano",
  "version": "3.0.0",
  "description": "Cardano SDK for XRAY/Network",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx test/__dev.ts",
    "build": "tsup",
    "test": "vitest run test/data.spec.ts test/message.spec.ts test/utils.spec.ts",
    "test:integration": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@scure/base": "2.2.0",
    "@scure/bip39": "2.2.0",
    "@xray-network/xray-cardano-lib": "0.1.0",
    "@xray-network/xray-cardano-lib-core": "0.1.0",
    "buffer": "^6.0.3",
    "cardano-koios-client": "^1.0.10",
    "cardano-kupo-client": "^1.0.1",
    "cardano-nftcdn-client": "^1.0.6",
    "cardano-ogmios-client": "^1.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsup": "^8.5.0",
    "tsx": "^4.15.1"
  }
}
