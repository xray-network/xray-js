{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": false,
    "module": "ESNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "sourceMap": false,
    "outDir": "dist",
    "paths": {
      "@": ["./src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "test"]
}
