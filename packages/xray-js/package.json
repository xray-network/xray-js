{
  "name": "@xray-network/xray-js",
  "version": "3.0.0",
  "description": "Multi-chain JavaScript SDK for XRAY/Network",
  "author": "XRAY/Network <hello@xray.app>",
  "license": "MIT",
  "homepage": "https://xray.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xray-network/xray-js.git",
    "directory": "packages/xray-js"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js",
      "require": "./dist/base.cjs"
    },
    "./cardano": {
      "types": "./dist/cardano.d.ts",
      "browser": "./dist/cardano.js",
      "node": {
        "import": "./dist/cardano.js",
        "require": "./dist/cardano.cjs"
      },
      "import": "./dist/cardano.js",
      "require": "./dist/cardano.cjs"
    },
    "./cardano/wasm": {
      "types": "./dist/cardano-wasm.d.ts",
      "browser": "./dist/cardano-wasm.js",
      "node": {
        "import": "./dist/cardano-wasm.js",
        "require": "./dist/cardano-wasm.cjs"
      },
      "import": "./dist/cardano-wasm.js",
      "require": "./dist/cardano-wasm.cjs"
    },
    "./cardano/mini-app": {
      "types": "./dist/cardano-mini-app.d.ts",
      "import": "./dist/cardano-mini-app.js"
    },
    "./cardano/mini-app/protocol": {
      "types": "./dist/cardano-mini-app-protocol.d.ts",
      "import": "./dist/cardano-mini-app-protocol.js"
    },
    "./cardano/mini-app/client": {
      "types": "./dist/cardano-mini-app-client.d.ts",
      "import": "./dist/cardano-mini-app-client.js"
    },
    "./cardano/mini-app/host": {
      "types": "./dist/cardano-mini-app-host.d.ts",
      "import": "./dist/cardano-mini-app-host.js"
    },
    "./cardano/mini-app/react": {
      "types": "./dist/cardano-mini-app-react.d.ts",
      "import": "./dist/cardano-mini-app-react.js"
    },
    "./cardano/mini-app/testing": {
      "types": "./dist/cardano-mini-app-testing.d.ts",
      "import": "./dist/cardano-mini-app-testing.js"
    },
    "./bitcoin": {
      "types": "./dist/bitcoin.d.ts",
      "import": "./dist/bitcoin.js",
      "require": "./dist/bitcoin.cjs"
    },
    "./midnight": {
      "types": "./dist/midnight.d.ts",
      "import": "./dist/midnight.js",
      "require": "./dist/midnight.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"process.exit(0)\"",
    "test:integration": "node -e \"process.exit(0)\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@xray-network/xray-js-base": "3.0.0",
    "@xray-network/xray-js-bitcoin": "3.0.0",
    "@xray-network/xray-js-cardano": "3.0.0",
    "@xray-network/xray-js-cardano-mini-app": "3.0.0",
    "@xray-network/xray-js-cardano-wasm": "3.0.0",
    "@xray-network/xray-js-midnight": "3.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
