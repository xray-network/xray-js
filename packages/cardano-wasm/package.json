{
  "name": "@xray-network/xray-js-cardano-wasm",
  "version": "3.0.0",
  "description": "Cardano Rust libraries compiled to WebAssembly",
  "license": "MIT",
  "type": "module",
  "main": "./src/nodejs.js",
  "types": "./src/nodejs.d.ts",
  "exports": {
    ".": {
      "types": "./src/nodejs.d.ts",
      "browser": "./src/browser.js",
      "node": {
        "import": "./src/nodejs.js",
        "require": "./src/nodejs.cjs"
      },
      "import": "./src/nodejs.js",
      "require": "./src/nodejs.cjs",
      "default": "./src/nodejs.js"
    },
    "./browser": {
      "types": "./src/browser.d.ts",
      "import": "./src/browser.js"
    },
    "./web": {
      "types": "./src/web.d.ts",
      "import": "./src/web.js"
    },
    "./nodejs": {
      "types": "./src/nodejs.d.ts",
      "import": "./src/nodejs.js",
      "require": "./src/nodejs.cjs",
      "default": "./src/nodejs.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"import('./src/nodejs.js')\"",
    "test:integration": "node -e \"process.exit(0)\"",
    "clean": "node -e \"process.exit(0)\"",
    "cml-build": "./scripts/cml-build.sh",
    "cml-update": "./scripts/cml-update.sh",
    "msl-build": "./scripts/msl-build.sh",
    "msl-update": "./scripts/msl-update.sh",
    "uplc-build": "./scripts/uplc-build.sh"
  }
}
