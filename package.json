{
  "name": "xray-js-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": {
    "packages": [
      "packages/xray-js",
      "packages/*/*"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mts,cts,json,md}\"",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build test typecheck && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@types/node": "^20.12.7",
    "prettier": "^3.2.5",
    "turbo": "^2.0.6",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
